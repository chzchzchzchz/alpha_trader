# Kalshi (required for anything that touches the API)
KALSHI_API_KEY_ID=YOUR_KALSHI_KEY_ID_HERE
KALSHI_API_KEY_FILE=/path/to/kalshi-private-key.pem

# Live-trading interlock (see core/trading_mode.py). Leave unset for paper.
# TRADING_MODE=paper
# LIVE_TRADING_ARMED=I_ACCEPT_REAL_MONEY_LOSS

# LLM agents (OpenRouter)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Optional: Alpaca (Java equities version)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: FRED macro data
FRED_API_KEY=YOUR_FRED_API_KEY_HERE

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
